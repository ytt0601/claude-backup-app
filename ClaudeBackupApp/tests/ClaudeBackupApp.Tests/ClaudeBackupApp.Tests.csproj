<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!--
      テスト対象の本体は self-contained (ランタイム同梱) で発行されるが、テストプロジェクト自体は
      フレームワーク依存で動く。開発機に .NET 8 ランタイムが入っておらず、より新しいメジャー
      バージョンだけがある場合でも testhost が起動できるようにしておく。
    -->
    <RollForward>LatestMajor</RollForward>

    <!--
      本体は WPF アプリだが、このテストプロジェクトでは UseWPF を有効にしない。
      UseWPF を有効にすると暗黙の using に System.Windows.Shapes が入り、
      Path が System.Windows.Shapes.Path と衝突するのを避けるため SDK が System.IO を
      暗黙 using から外す。テストはパス操作が中心なので、WPF を持ち込まない方が素直。
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeBackupApp\ClaudeBackupApp.csproj" />
  </ItemGroup>

</Project>
